{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legamind",
  "version": "0.1.38",
  "identifier": "com.legamind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Legamind",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu --enable-spell-checking --lang=ru"
      },
      {
        "label": "overlay",
        "title": "Legamind — быстрый вопрос",
        "url": "index.html?overlay=1",
        "width": 760,
        "height": 460,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu --enable-spell-checking --lang=ru"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine": "engine",
      "../sidecar-dist/legamind-engine": "engine-bin"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQTFBOUI1QzMyQzFDNTcKUldSWEhDekR0YW1oNGZqN3UvZklCN1hFRnRORldTV1E4dlVtSkZVaHFBTiszNktWKzZ3L0R6Z0gK",
      "endpoints": [
        "https://github.com/leganoid/legamind/releases/latest/download/latest.json"
      ]
    }
  }
}
